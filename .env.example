# =============================================================
# TaskFlow · variables de entorno (Clase 3)
# Este archivo SÍ se sube a Git. Cópialo como .env y completa los valores:
#   Copy-Item .env.example .env      (bash: cp .env.example .env)
# El .env real NUNCA se sube (está en .gitignore).
# =============================================================

# Credenciales del usuario root de MongoDB (solo se aplican la PRIMERA vez que se crea el volumen)
MONGO_USER=admin
MONGO_PASSWORD=

# URL con la que el NAVEGADOR llega a la API (se hornea en el build del frontend)
VITE_API_URL=http://localhost:3000

# Orígenes permitidos por CORS en la API (separados por coma)
CORS_ORIGIN=http://localhost:8080

# ---------- Clase 5 · docker-compose.prod.yml (imágenes publicadas en GHCR) ----------
# Usuario u organización de GitHub, en minúsculas
GHCR_OWNER=alexsoftware31
# latest | sha-xxxxxxx | 1.0.0  (cambiarlo = rollback a otra versión)
IMAGE_TAG=latest
