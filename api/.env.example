# Copiar como .env para correr la API sin Docker (npm run dev)
PORT=3000
MONGO_URI=mongodb://admin:secret@localhost:27017/taskflow?authSource=admin
# Clase 6 · para probar contra MongoDB Atlas, reemplazar por la cadena de Atlas (con /taskflow antes del ?):
# MONGO_URI=mongodb+srv://taskflow-app:<clave>@<cluster>.xxxxx.mongodb.net/taskflow?retryWrites=true&w=majority
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ---------- Clase 7 · operación ----------
# development = logs legibles con pino-pretty · production = JSON (lo que usa Docker/Render)
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent  (en producción: info)
LOG_LEVEL=debug
# En producción lo pone el CD (commit desplegado); en local basta con "local"
APP_VERSION=local
